# Todo lo que empieza con VITE_ termina en el navegador: no pongas secretos aquí.

# URL del backend FastAPI.
VITE_API_URL=http://localhost:8000

# Supabase (solo Auth). Se rellenan desde el panel: Project Settings > API.
# Las tres variables son OBLIGATORIAS: el cliente las usa para iniciar sesión y, sin
# alguna de ellas, la app muestra "Falta configuración". La clave es la *publishable*
# (pública por diseño); nunca pongas aquí una clave secret/service_role.
# Vite las incrusta en el build: si cambian, hay que construir y desplegar de nuevo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
