# La aplicación lee estas variables del entorno del proceso; no carga este
# archivo automáticamente. Para /health y el desarrollo local solo importa
# FRONTEND_ORIGIN, y su valor por defecto basta. Sin las demás, las rutas de
# juego responden 503 (no hay modo "sin login").
#
# Origen(es) del frontend permitidos por CORS, separados por comas.
# Sin esta variable se usa solo http://localhost:5173 (desarrollo).
# En producción, el origen real de Netlify, p. ej. https://tu-sitio.netlify.app
# No se admite "*". CORS no sustituye la autorización de cada endpoint.
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase ---

# URL del proyecto, p. ej. https://<project-ref>.supabase.co
# Se usa para validar el token del usuario (GET /auth/v1/user).
SUPABASE_URL=
# Clave publicable (pública por diseño; no da acceso a datos por sí sola).
SUPABASE_PUBLISHABLE_KEY=

# Cadena de conexión PostgreSQL. PRIVADA: solo backend, nunca en VITE_* ni en
# Git. Cópiala desde el botón Connect del panel; no inventes el host.
# Si no trae sslmode, el backend usa sslmode=require. Con el pooler en modo
# transacción no se usan sentencias preparadas.
DATABASE_URL=

# No añadas una clave secret/service_role: este backend no la necesita.
